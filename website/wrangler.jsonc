{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "worldwide-cargo-express",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worldwide-cargo-applications",
      "database_id": "bc1bafb4-f69f-4106-b134-7ff2090f36d4",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGINS": "https://edgeformmedia-pixel.github.io,https://worldwidecargoexpressllc.com,https://www.worldwidecargoexpressllc.com"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
